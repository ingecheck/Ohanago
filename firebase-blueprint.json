{
  "entities": {
    "RouletteState": {
      "title": "RouletteState",
      "description": "Estado en tiempo real de la ruleta oficial de sorteos",
      "type": "object",
      "properties": {
        "isActive": { "type": "boolean" },
        "totalTickets": { "type": "number" },
        "totalDraws": { "type": "number" },
        "currentDrawNumber": { "type": "number" },
        "currentPrizeName": { "type": "string" },
        "isSpinning": { "type": "boolean" },
        "spinStartTime": { "type": "number" },
        "spinDuration": { "type": "number" },
        "targetTicket": { "type": "number" },
        "targetAngle": { "type": "number" },
        "winners": { "type": "array" },
        "lastWinner": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["totalTickets", "totalDraws", "currentDrawNumber", "isSpinning"]
    },
    "RunnerRegistration": {
      "title": "RunnerRegistration",
      "description": "Ficha oficial ordenada de datos escritos del participante (las fotos y constancias viven exclusivamente en Google Drive)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "registrationNumber": { "type": "number" },
        "bibNumber": { "type": "number" },
        "edition": { "type": "string" },
        "createdAt": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "documentType": { "type": "string" },
        "documentNumber": { "type": "string" },
        "whatsapp": { "type": "string" },
        "age": { "type": "number" },
        "tShirtSize": { "type": "string" },
        "gender": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "district": { "type": "string" },
        "department": { "type": "string" },
        "runningClub": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentReference": { "type": "string" },
        "amountPaid": { "type": "number" },
        "hasPreviousDiscount": { "type": "boolean" },
        "paymentStatus": { "type": "string" },
        "turkeyRaffleTicket": { "type": "string" },
        "disclaimerAccepted": { "type": "boolean" },
        "drivePhotoFileId": { "type": "string" },
        "drivePhotoUrl": { "type": "string" },
        "driveVoucherFileId": { "type": "string" },
        "driveVoucherUrl": { "type": "string" },
        "modality": { "type": "string" },
        "confirmedAtStart": { "type": "boolean" },
        "startCheckinTime": { "type": "string" },
        "finishedAtMeta": { "type": "boolean" },
        "finishCheckinTime": { "type": "string" },
        "medalDelivered": { "type": "boolean" }
      },
      "required": ["id", "firstName", "lastName", "documentNumber"]
    }
  },
  "firestore": {
    "/roulette/current": {
      "schema": "RouletteState",
      "description": "Documento único que sincroniza el giro y estado de la ruleta en vivo para todos los celulares"
    },
    "/registrations/{registrationId}": {
      "schema": "RunnerRegistration",
      "description": "Nómina ordenada de datos escritos de corredores y acreditaciones en tiempo real (sin fotos en BD)"
    }
  }
}
